          "script": {
            "exec": [
              "// Test 1: Verificar que el servidor responde con status 200 OK",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Test 2: Verificar que la respuesta es un JSON con datos",
              "pm.test(\"La respuesta contiene un array de personajes\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data).to.be.an('array');",
              "});",
              "",
              "// Test 3: Verificar que el tiempo de respuesta es rápido (buen rendimiento)",
              "pm.test(\"Tiempo de respuesta inferior a 3000ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(3000);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
